# Ignore everything by default
*

# Config files
!.gitignore
!CLAUDE.md
!RTK.md
!settings.json
!statusline-command.sh
!README.md

# Plugin manifest + self-hosted marketplace
!.claude-plugin/
!.claude-plugin/*.json

# Knowledge (refactor catalog + other reference material, loaded on demand)
!knowledge/
!knowledge/**

# Hooks
!hooks/
!hooks/hooks.json
!hooks/rtk-rewrite.sh
!hooks/on-enter-worktree.sh
!hooks/worktree-warming.md
!hooks/log-skill-invocation.sh

# Worktree dep-warming worker (global default)
!warm-deps.sh

# Commands
!commands/
!commands/*.md

# Agents (flat: the plugin loader reads agents/<name>.md, not agents/<name>/Agent.md)
!agents/
!agents/*.md

# Skills
!skills/
!skills/*/
!skills/*/SKILL.md

# Scripts
!scripts/
!scripts/*.sh

# Tools (support scripts for on-demand commands, e.g. /mutation-audit)
!tools/
!tools/**
tools/**/__pycache__/

# Examples
!examples/
!examples/*.json

# Memory
!memory/
!memory/**
!MEMORY.md

# Docs (engineering findings / lab notebook)
!docs/
!docs/**

# Evals
!evals/
!evals/**
# ...but not the regenerable per-machine fingerprint cache or temp progress notes
evals/**/.eval-cache.json
evals/PROGRESS.md
# ...nor the Skill-invocation log the global PreToolUse hook writes during eval dispatches
evals/**/.skill-invocations.log
.skill-invocations.log
# ...nor the golden repos' build outputs / gradle daemon state (regenerable)
evals/golden-repo/build/
evals/golden-repo/.gradle/
evals/golden-repo/**/build/
evals/golden-repo-spring/build/
evals/golden-repo-spring/.gradle/
evals/golden-repo-spring/.kotlin/
evals/golden-repo-spring/**/build/
# ...nor Python bytecode from the graders importing each other
evals/**/__pycache__/

# macOS junk — re-ignore everywhere (the broad !dir/** whitelists re-include it)
**/.DS_Store

# Experimental arm workspaces: each is a measurement record, kept out of the
# config repo. Scorecards under evals/benchmark/scorecards/ ARE committed.
evals/benchmark/runs/

# An arm's stdout. The scorecard is the record; this is a transcript of one run and
# is not reproducible from the repo. Note the '!evals/**' rule above un-ignores
# everything under evals/, so without this a 'git add -A' sweeps these in.
evals/benchmark/*-run.log
evals/benchmark/confirmation-driver.log
