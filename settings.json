{
  "permissions": {
    "allow": [
      "Bash(pnpm ts-mocha:*)",
      "Bash(./gradlew connectedAndroidTest*)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/log-skill-invocation.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "extraKnownMarketplaces": {
    "claude-flow": {
      "source": { "source": "github", "repo": "chiaradiamarcelo/claude-flow" }
    }
  },
  "enabledPlugins": {
    "claude-flow@claude-flow": true,
    "typescript-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "theme": "light",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
